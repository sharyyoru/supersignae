NEXT_PUBLIC_APP_URL=https://supersignae.vercel.app
NEXT_PUBLIC_SITE_NAME=SuperSignAE

# Session encryption (32+ chars)
IRON_SESSION_PASSWORD=change-me-to-32-char-min-secret

# Seed the first admin account
ADMIN_EMAIL=wilson@drehomes.com
ADMIN_PASSWORD_HASH=

# Supabase Postgres (use the connection string from your Supabase project)
# For Prisma + PgBouncer add ?pgbouncer=true to DATABASE_URL
DATABASE_URL=
DIRECT_URL=

# Supabase Storage / Auth (fill in if you want hosted image uploads or OAuth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@drehomes.com

# Microsoft / Outlook one-click install (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
